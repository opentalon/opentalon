test "Small, tested, non-critical PR is approved" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 101
    attr 1 "pr.lines_changed" 50
    attr 1 "pr.files_changed" 3
    attr 1 "pr.draft" false
    attr 1 "pr.tests_passing" true
    attr 1 "pr.changed_files" ["cmd/cli/main.go", "pkg/util/helpers.go"]
  }

  when rule "Auto-approve safe changes"

  expect {
    flagged 1
    did 1 approve "pr"
  }
}

test "Large PR is not auto-approved" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 102
    attr 1 "pr.lines_changed" 150
    attr 1 "pr.files_changed" 10
    attr 1 "pr.draft" false
    attr 1 "pr.tests_passing" true
    attr 1 "pr.changed_files" ["cmd/cli/main.go"]
  }

  when rule "Auto-approve safe changes"

  expect {
    not flagged 1
  }
}

test "PR with no description is blocked" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 103
    attr 1 "pr.draft" false
    attr 1 "pr.has_description" false
  }

  when rule "Block PRs with no description"

  expect {
    flagged 1
    did 1 block "pr.merge"
  }
}

test "PR with description is not blocked for description" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 104
    attr 1 "pr.draft" false
    attr 1 "pr.has_description" true
  }

  when rule "Block PRs with no description"

  expect {
    not flagged 1
  }
}

test "PR with failing tests is blocked" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 105
    attr 1 "pr.draft" false
    attr 1 "pr.tests_passing" false
  }

  when rule "Block PRs with failing tests"

  expect {
    flagged 1
    did 1 block "pr.merge"
  }
}

test "PR with passing tests is not blocked by test rule" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 106
    attr 1 "pr.draft" false
    attr 1 "pr.tests_passing" true
  }

  when rule "Block PRs with failing tests"

  expect {
    not flagged 1
  }
}

test "Critical-path auth change gets senior review" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 107
    attr 1 "pr.draft" false
    attr 1 "pr.changed_files" ["internal/auth/token.go", "pkg/util/helpers.go"]
  }

  when rule "Flag critical-path changes for senior review"

  expect {
    flagged 1
    did 1 require "review.senior"
  }
}

test "Critical-path runtime change gets senior review" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 108
    attr 1 "pr.draft" false
    attr 1 "pr.changed_files" ["pkg/runtime/executor.go"]
  }

  when rule "Flag critical-path changes for senior review"

  expect {
    flagged 1
    did 1 require "review.senior"
  }
}

test "Non-critical change does not trigger senior review" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 109
    attr 1 "pr.draft" false
    attr 1 "pr.changed_files" ["cmd/cli/flags.go", "docs/guide.md"]
  }

  when rule "Flag critical-path changes for senior review"

  expect {
    not flagged 1
  }
}

test "Draft PR is not auto-approved" {
  given {
    record 1 type "pr"
    attr 1 "pr.number" 110
    attr 1 "pr.lines_changed" 30
    attr 1 "pr.files_changed" 2
    attr 1 "pr.draft" true
    attr 1 "pr.tests_passing" true
    attr 1 "pr.changed_files" ["docs/example.md"]
  }

  when rule "Auto-approve safe changes"

  expect {
    not flagged 1
  }
}