# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/opentalon
/cmd/opentalon/opentalon

# Test binary
*.test
# ...but keep Talooner rule tests, which share the .test suffix
!.talooner/*.tln.test

# Output of go coverage
*.out
coverage.html

# Go workspace
go.work
go.work.sum

# Dependency dirs
/vendor/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Env / secrets (do not commit)
.env
.env.local
*.local

# Local config (paths, API keys) — copy config.example.yaml to config.yaml
config.yaml
config.local.yaml

# Local plugin state written next to the binary (e.g. a plugin's SQLite file)
*.db
*.db-shm
*.db-wal

# Build / tmp
/dist/
/tmp/
*.log

channels/*
!channels/.gitkeep

plugins/*
!plugins/.gitkeep
.cursor/

# ...keep the Talooner config, which the credential pattern above also matches
!.talooner/config.yaml
